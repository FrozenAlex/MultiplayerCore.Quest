{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.1.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "MultiplayerCore",
    "id": "multiplayer-core",
    "version": "1.6.8",
    "url": "https://github.com/EnderdracheLP/MultiplayerCore.Quest",
    "additionalData": {
      "overrideSoName": "libMultiplayerCore.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "pwsh build.ps1 -release $0:?"
      ],
      "bump": [
        "pwsh ./scripts/bumpQPMdeps.ps1 $0:?"
      ],
      "clean": [
        "qpm s build -- -clean $0:?"
      ],
      "copy": [
        "pwsh copy.ps1 $0:?"
      ],
      "prepare-debugger": [
        "pwsh PrepareEnvForDebugger.ps1 $0:?"
      ],
      "qmod": [
        "pwsh buildQMOD.ps1 MultiplayerCore $0:?"
      ],
      "stack": [
        "pwsh ndk-stack.ps1 $0:?"
      ]
    },
    "ndk": "^29.0.14206865",
    "qmodIncludeDirs": [
      "extern/libs",
      "build"
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "MultiplayerCore.qmod"
  },
  "dependencies": [
    {
      "id": "libil2cpp",
      "versionRange": "^0.5.0",
      "additionalData": {}
    },
    {
      "id": "beatsaber-hook",
      "versionRange": "^9.4.3",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "^4503.0.0",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.21.2",
      "additionalData": {}
    },
    {
      "id": "songcore",
      "versionRange": "^1.3.5",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.7",
      "additionalData": {
        "includeQmod": false,
        "private": true
      }
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.8.0",
      "additionalData": {}
    },
    {
      "id": "lapiz",
      "versionRange": "^0.3.7",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.6.7",
      "additionalData": {
        "private": true
      }
    },
    {
      "id": "cpp-semver",
      "versionRange": "^0.1.2",
      "additionalData": {
        "private": true
      }
    },
    {
      "id": "capstone",
      "versionRange": "^0.1.0",
      "additionalData": {}
    },
    {
      "id": "kaleb",
      "versionRange": "^0.1.9",
      "additionalData": {}
    },
    {
      "id": "beatsaverplusplus",
      "versionRange": "^0.2.4",
      "additionalData": {}
    },
    {
      "id": "web-utils",
      "versionRange": "^0.6.10",
      "additionalData": {}
    },
    {
      "id": "flamingo",
      "versionRange": "^1.3.1",
      "additionalData": {}
    }
  ]
}